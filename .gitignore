# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build
/.output

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.wrangler/
/api/.seed/
/api/.tmp/

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local analysis state
.gitnexus/
