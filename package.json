{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview:pages": "wrangler pages dev --ip 127.0.0.1 --port 8788",
    "verify:static": "node scripts/verify-static-export.mjs",
    "test:browser": "playwright test",
    "test:admin:preview": "node scripts/smoke-admin-preview.mjs",
    "test:public:cloudflare": "node scripts/smoke-public-cloudflare.mjs",
    "test:smoke": "npm run build && npm run verify:static && npm run test:browser",
    "api:dev": "pnpm --filter @portfolio/api dev",
    "api:deploy": "pnpm --filter @portfolio/api run deploy",
    "api:deploy:staging": "pnpm --filter @portfolio/api run deploy:staging",
    "api:typecheck": "pnpm --filter @portfolio/api typecheck",
    "api:test": "pnpm --filter @portfolio/api test",
    "db:migrate:local": "pnpm --filter @portfolio/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @portfolio/api db:migrate:remote",
    "db:migrate:staging": "pnpm --filter @portfolio/api db:migrate:staging",
    "db:seed:local": "pnpm --filter @portfolio/api db:seed:local",
    "db:seed:remote": "pnpm --filter @portfolio/api db:seed:remote",
    "db:seed:staging": "pnpm --filter @portfolio/api db:seed:staging",
    "admin:bootstrap:local": "pnpm --filter @portfolio/api admin:bootstrap:local",
    "admin:bootstrap:staging": "pnpm --filter @portfolio/api admin:bootstrap:staging",
    "api:smoke:staging": "pnpm --filter @portfolio/api smoke:staging"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
